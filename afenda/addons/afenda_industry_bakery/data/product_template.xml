        <!-- Finished goods: sold over the counter, so list_price rather than
             standard_price, and no lot tracking.

             available_in_pos is set here because it defaults to False
             (addons/point_of_sale/models/product_template.py:24): without it the
             Bakery Counter that Task 4 creates opens onto an empty product grid,
             which is the one thing this pack exists to configure. pos_categ_ids
             is deliberately NOT set, because the POS categories do not exist
             until Task 4's hook creates them: that assignment belongs there. -->
        <record id="product_sourdough" model="product.template">
