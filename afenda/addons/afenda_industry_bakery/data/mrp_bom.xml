<odoo>
    <data noupdate="1">
        <!-- Headers only, on purpose. mrp.bom.line.product_id is a
             product.product (addons/mrp/models/mrp_bom.py:684), and the variant
             Odoo auto-creates for a template seeded by XML carries no XMLID of
             its own, so no ref= in this file can name a component. The lines are
             seeded in Python instead, by hooks.py's _seed_bom_lines, where
             env.ref(...).product_variant_id resolves.

             product_uom_id is uom.product_uom_unit for all twelve because every
             finished good is sold by the piece (data/product_template.xml).

             company_id is absent from these records, which is not the same as
             the headers being company neutral: mrp.bom.company_id defaults to
             self.env.company (addons/mrp/models/mrp_bom.py:67-69), so each
             header is created owned by whichever company installs the pack, and
             a second company in the same database sees no bills of material at
             all. That single company ownership is accepted, and recorded, in
             docs/superpowers/specs/2026-09-24-afenda-industry-packs-design.md
             ruling 1, in its paragraph on the bill-of-material headers. Naming
             the field here would only pin down in XML what the default already
             decides, and test_data_xml_sets_no_company_id forbids it. -->
        <record id="bom_sourdough" model="mrp.bom">
            <field name="product_tmpl_id" ref="product_sourdough"/>
            <field name="product_qty">1</field>
            <field name="product_uom_id" ref="uom.product_uom_unit"/>
            <field name="type">normal</field>
        </record>
        <record id="bom_baguette" model="mrp.bom">
