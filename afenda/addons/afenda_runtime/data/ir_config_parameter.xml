<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Point every Odoo-hosted service endpoint that a parameter can redirect at
    the discard port on loopback. A call that slips past the null adapters in
    models/ then fails at once, locally, instead of reaching an outside host.

    noupdate: `<function>` runs only at install (odoo/tools/convert.py:272-274),
    so an operator who later points one of these at a service of their own
    keeps that value across module updates.

    `iap_vies.endpoint` is deliberately absent: base_vat accepts only its two
    hard-coded hosts and raises on any other value
    (addons/base_vat/models/res_partner.py:263-268).

    `auth_signup.invitation_scope = b2b` makes the ERP invitation-only: without
    a token, /web/signup 404s unless the scope is b2c
    (addons/auth_signup/controllers/main.py:43-44, :132). auth_signup sets b2c
    at its own install (addons/auth_signup/data/ir_config_parameter_data.xml:5);
    the manifest depends on it so this line runs after that one. A database
    that already had this module gets b2b once from
    migrations/19.0.1.1.0/post-migrate.py.
    -->
    <data noupdate="1">
        <function model="ir.config_parameter" name="set_param" eval="('iap.endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('sms.endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('snailmail.endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('html_editor.olg_api_endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('html_editor.media_library_endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('iap.partner_autocomplete.endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('enrich.endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('reveal.endpoint', 'http://127.0.0.1:9')"/>
        <function model="ir.config_parameter" name="set_param" eval="('auth_signup.invitation_scope', 'b2b')"/>
    </data>
</odoo>
